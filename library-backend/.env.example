# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in values before running
# ──────────────────────────────────────────────────────────────────────────────

# Database connection — used by FastAPI app and Alembic migrations
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
#
# When running via docker-compose, host = "db" (the service name)
# When running locally (outside Docker), host = "localhost"

DATABASE_URL=postgresql+asyncpg://library_user:library_pass@db:5432/library_db

# Set to "1" to enable SQLAlchemy query logging (useful for debugging)
SQL_ECHO=
