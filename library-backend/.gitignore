# ──────────────────────────────────────────────
# library-backend/.gitignore
# ──────────────────────────────────────────────

# Secrets
.env

# Virtual environments
.venv/
.venv_old/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checkers
.mypy_cache/
.dmypy.json

# Backup / temp files
*.bk
*.bk1
*.bk2
*.updated
*.orig

# Alembic (do NOT ignore migrations/versions — those are source-controlled)
# Only ignore autogenerated temp files if any

# OS
.DS_Store
